# Токен от @BotFather. Обязательный параметр.
BOT_TOKEN=

# Файл базы SQLite.
DATABASE_PATH=bot.db

# Как часто ходить за ценой задано в коде: DNS и Яндекс.Маркет —
# раз в сутки, Ozon — раз в час. Строка CHECK_INTERVAL в старом
# .env больше не читается.

# Пауза между карточками внутри одного цикла.
FETCH_GAP=45s

# Сколько карточек максимум трогать за один цикл.
FETCH_PER_CYCLE=8

# Не ходить на DNS сразу после запуска процесса.
STARTUP_DELAY=1m

# Сколько молчать, если QRATOR показал челлендж или оборвал соединение.
CIRCUIT_COOLDOWN=45m

# Отдельный профиль обычного Chrome. data/chrome-profile после CDP
# Ozon помечает как бота — его больше не используем.
CHROME_PROFILE=data/chrome-plain

# Пусто — искать Google Chrome в стандартном месте.
CHROME_PATH=

# Игнорируется: цены читает расширение в обычном окне Chrome.
CHROME_HEADLESS=0

# Город, для которого фиксируются цены: на DNS цена зависит от региона.
DEFAULT_CITY=moscow

# Список Telegram user id через запятую. Пусто — доступ открыт всем.
ALLOWED_USERS=

# Локальная страница со всеми заявками. Только 127.0.0.1 / localhost / ::1.
# off — не поднимать HTTP. 0.0.0.0 и :8080 не принимаются.
UI_ADDR=127.0.0.1:8080

# Окно со списком ссылок и графиками цен + иконка в трее.
# off — только Telegram и веб-страница.
GUI=1
