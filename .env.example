# Токен от @BotFather. Обязательный параметр.
BOT_TOKEN=

# Файл базы SQLite.
DATABASE_PATH=bot.db

# Как часто проверять цены. Учтите, что один товар занимает несколько секунд,
# а проверки по одному сайту идут последовательно.
CHECK_INTERVAL=20m

# Город, для которого фиксируются цены: на DNS цена зависит от региона.
DEFAULT_CITY=moscow

# Список Telegram user id через запятую. Пусто — доступ открыт всем.
ALLOWED_USERS=
